# Copy to .env (same folder) and fill in. ADK loads it automatically for `adk web` / `adk run`.

# --- Model access: Option A (ADC, recommended) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# --- Model access: Option B (API key) - comment out Option A and set: ---
# GOOGLE_API_KEY=your-key

# --- MCP server ---
# Local server or `gcloud run services proxy helpdesk-mcp --region=us-central1 --port=8080`
MCP_SERVER_URL=http://127.0.0.1:8080/mcp
# MCP_AUTH_TOKEN=   # only for direct calls to a private Cloud Run URL

AGENT_MODEL=gemini-flash-latest
